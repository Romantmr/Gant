# Netlify redirects for Gantt Chart Platform

# SPA fallback - redirect all routes to index.html
/*    /index.html   200

# Handle common web app routes
/app/*    /index.html   200
/dashboard/*    /index.html   200
/projects/*    /index.html   200
/tasks/*    /index.html   200

# API routes (if needed in the future)
/api/*    /api/:splat   200

# Handle file downloads
/downloads/*    /downloads/:splat   200

# Handle exports
/export/*    /index.html   200
