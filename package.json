{
  "name": "gantt-chart-platform",
  "version": "1.0.0",
  "description": "Современная веб-платформа для создания и управления диаграммами Ганта с полным функционалом ProjectLibre",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=3000 --open=/index.html",
    "build": "echo 'No build step required for static site'",
    "deploy": "echo 'Deploy to Netlify via Git integration'",
    "lint": "echo 'Linting not configured for vanilla JS project'",
    "test": "echo 'No tests specified'",
    "serve": "npx serve . -s",
    "preview": "npx serve . -s -l 3000"
  },
  "keywords": [
    "gantt",
    "chart",
    "project-management",
    "timeline",
    "tasks",
    "dependencies",
    "projectlibre",
    "web-app",
    "javascript",
    "html5",
    "css3"
  ],
  "author": "Gantt Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/gantt-chart-platform.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/gantt-chart-platform/issues"
  },
  "homepage": "https://your-netlify-app.netlify.app",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "serve": "^14.2.1"
  },
  "dependencies": {},
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "files": [
    "index.html",
    "styles/",
    "js/",
    "README.md",
    "netlify.toml",
    ".gitignore"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "config": {
    "port": 3000,
    "host": "localhost"
  },
  "netlify": {
    "build": {
      "command": "echo 'No build step required'",
      "publish": "."
    },
    "redirects": [
      {
        "from": "/*",
        "to": "/index.html",
        "status": 200
      }
    ]
  }
}
